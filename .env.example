# Copy to .env (gitignored) to enable Claude for the voice check-in and Help chat.
# Without a key the app uses its built-in rule engine.
ANTHROPIC_API_KEY=
# Optional overrides (defaults shown)
SMART_HOME_AI_MODEL=claude-sonnet-5-5
SMART_HOME_AI_EFFORT=medium
# SMART_HOME_AI=off   # force the rule engine
